{
  "kind": "collectionType",
  "collectionName": "labels",
  "info": {
    "singularName": "label",
    "pluralName": "labels",
    "displayName": "Label",
    "description": "Flexible tag for grouping tickets"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "color": {
      "type": "string"
    },
    "tickets": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::ticket.ticket",
      "mappedBy": "labels"
    }
  }
}
